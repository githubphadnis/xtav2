# xtav2 local / compose defaults — copy to .env

APP_LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Amsterdam
BASE_CURRENCY=EUR

DATABASE_URL=postgresql://xtav2:xtav2@postgres:5432/xtav2
POSTGRES_USER=xtav2
POSTGRES_PASSWORD=xtav2
POSTGRES_DB=xtav2

OLLAMA_BASE_URL=http://lenai:11434
# Must match a model from `ollama list` on lenai (404 on /api/chat = wrong name).
# Default matches current lenai inventory (Jul 2026); override in Portainer if needed.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=60

# Host port on notcoolio (8080 is usually taken by monsoon/XTA)
XTAV2_HOST_PORT=4280

# Feature flags (see docs/feature-flags.md)
FEATURE_MANUAL_ENTRY=true
FEATURE_MULTI_CURRENCY=true
FEATURE_OLLAMA_QA=true
FEATURE_MCP=true
FEATURE_RECEIPT_OCR=false
FEATURE_MASS_UPLOAD=false
FEATURE_OCR_OLLAMA_VISION=false
FEATURE_OCR_GOOGLE_VISION=false
FEATURE_BANK_IMPORT=false
FEATURE_EMAIL_INGEST=false
FEATURE_LINE_ITEMS=false
FEATURE_SAVINGS_INSIGHTS=false
FEATURE_TRENDS_UI=false
FEATURE_GEO=false
